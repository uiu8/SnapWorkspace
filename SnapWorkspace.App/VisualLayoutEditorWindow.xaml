<Window x:Class="SnapWorkspace.App.VisualLayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可视化布局编辑器" Width="1040" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="原生布局编排器" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="拖动分隔线会吸附到受支持的 Snap Layout；空槽位保留在模型中并显示桌面。"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="当前原生模型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="LayoutNameBox" Margin="0,5,0,0" IsReadOnly="True" IsTabStop="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="292"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="LayoutMetricsText" FontWeight="SemiBold"/>
                        <TextBlock Text="松开后吸附到原生比例" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#111722" BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="8">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="ZoneCanvas" Width="640" Height="400"
                                    Background="#0C111A" SizeChanged="ZoneCanvas_SizeChanged"/>
                        </Viewbox>
                    </Border>
                    <WrapPanel Grid.Row="4">
                        <Button Content="左右拆分" Style="{StaticResource SecondaryButtonStyle}" Click="SplitVertical_Click"/>
                        <Button Content="上下拆分" Style="{StaticResource SecondaryButtonStyle}" Click="SplitHorizontal_Click" Margin="8,0,0,0"/>
                        <Button Content="合并所选" Style="{StaticResource SecondaryButtonStyle}" Click="MergeSelected_Click" Margin="8,0,0,0"/>
                        <Button Content="留空所选" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteSelected_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="应用" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="拖到左侧槽位；未分配的槽位仍显示桌面。"
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,10"/>
                    <ListBox x:Name="ApplicationList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseMove="ApplicationList_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="清空所选槽位的应用" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ClearAssignment_Click" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock x:Name="EditorStatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="恢复初始布局" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click"/>
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="8,0,0,0"/>
                <Button Content="应用原生模型" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
