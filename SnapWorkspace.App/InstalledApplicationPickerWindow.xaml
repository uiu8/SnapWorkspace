<Window x:Class="SnapWorkspace.App.InstalledApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择已安装应用" Width="780" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="选择已安装应用" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="应用不必正在运行；支持开始菜单、传统 EXE 和 UWP / MSIX。"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" ToolTip="搜索名称、路径或 AUMID" TextChanged="SearchBox_TextChanged" Padding="10,7"/>
            <CheckBox x:Name="FavoritesOnlyToggle" Grid.Column="1" Content="只看收藏" Margin="16,0,0,0"
                      VerticalAlignment="Center" Click="FavoritesOnlyToggle_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="12" Padding="6">
            <ListBox x:Name="ApplicationList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="ApplicationList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6" MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                <Border Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="7"/>
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <Image Source="{Binding Entry.Icon}" Width="24" Height="24"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                <TextBlock Text="{Binding Entry.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Entry.Details}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Entry.SourceLabel}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="{Binding StarGlyph}" FontFamily="Segoe UI Symbol"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="7,5" Tag="{Binding}"
                                    Click="FavoriteApplication_Click" ToolTip="收藏 / 取消收藏"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{DynamicResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Content="选择应用" Style="{DynamicResource AccentButtonStyle}" Margin="10,0,0,0" Click="Choose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
