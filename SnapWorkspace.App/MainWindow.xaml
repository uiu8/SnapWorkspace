                                            HorizontalAlignment="Right" Click="AddRecommendedCaptureExclusions_Click"/>
                                </Grid>
                                <TextBlock Text="这些应用不会出现在任务栏、托盘或纯后台捕捉结果中。"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10"/>
                                <ItemsControl x:Name="BlockedApplicationsRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MatchDetails}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="取消屏蔽" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,5" Tag="{Binding}" Click="UnblockCaptureApplication_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="支持可执行路径、通配符、应用包族和发布者规则；推荐项不会自动启用。" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="数据位置" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DataPathText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,10" TextWrapping="Wrap"/>
                                <Button Content="在文件资源管理器中打开" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Click="OpenDataFolder_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" x:Name="StatusBar" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="StatusText" Text="正在启动…" Margin="9,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
