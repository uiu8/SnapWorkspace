<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SnapWorkspace</AssemblyName>
    <RootNamespace>SnapWorkspace.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnapWorkspace.ico</ApplicationIcon>
    <Version>0.9.5</Version>
    <FileVersion>0.9.5.0</FileVersion>
    <AssemblyVersion>0.9.5.0</AssemblyVersion>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapWorkspace.Route3.Core\SnapWorkspace.Route3.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\SnapWorkspace.ico" />
    <Resource Include="Assets\SnapWorkspace.png" />
  </ItemGroup>
</Project>
