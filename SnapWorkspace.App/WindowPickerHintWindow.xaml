<Window x:Class="SnapWorkspace.App.WindowPickerHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="82"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AutomationProperties.Name="手动捕捉窗口提示">
    <Border Background="#F0191D27" BorderBrush="#8B7C69FF" BorderThickness="1"
            CornerRadius="16" Padding="18,13">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="#7C69FF">
                <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons" Foreground="White"
                           FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,-1,0,0">
                <TextBlock Text="点击要加入工作区的窗口" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="左键选择 · Esc 或右键取消" Foreground="#BFC7D8" Margin="0,4,0,0" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
