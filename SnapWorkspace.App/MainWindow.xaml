<Window x:Class="SnapWorkspace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapWorkspace.App.Controls"
        Title="Snap Workspace"
        Icon="Assets/SnapWorkspace.ico"
        Width="1180" Height="780" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AutomationProperties.Name="Snap Workspace 主窗口"
        KeyboardNavigation.TabNavigation="Local"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,28">
                    <Border Width="36" Height="36" CornerRadius="8" Background="Transparent">
                        <Image Source="Assets/SnapWorkspace.png" Width="34" Height="34"
                               Stretch="Uniform" AutomationProperties.Name="Snap Workspace 图标"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Snap Workspace" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Route 3 preview" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButtonStyle}" Click="Library_Click"
                            AutomationProperties.Name="工作区" AutomationProperties.AccessKey="Alt+1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Width="28"/>
                            <TextBlock Text="工作区"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="NewWorkspace_Click"
                            AutomationProperties.Name="新建工作区" AutomationProperties.AccessKey="Ctrl+N">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Width="28"/>
                            <TextBlock Text="新建工作区"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="CaptureWorkspace_Click"
                            AutomationProperties.Name="捕捉工作区" AutomationProperties.AccessKey="Ctrl+Shift+C">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" Width="28"/>
                            <TextBlock Text="捕捉工作区"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="RefreshWindows_Click"
                            AutomationProperties.Name="刷新窗口" AutomationProperties.AccessKey="F5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Width="28"/>
                            <TextBlock Text="刷新窗口"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Settings_Click"
                            AutomationProperties.Name="设置" AutomationProperties.AccessKey="Ctrl+逗号">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="28"/>
                            <TextBlock Text="设置"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="13" CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CapabilityDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CapabilityTitle" Text="正在检测 Shell…" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="CapabilityDetails" Text="不会移动任何窗口" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="16,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="工作区" FontSize="28" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="PageSubtitle" Text="保存并恢复你的窗口组合" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="LibraryView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="原生 Snap，按需占用" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="选择任意布局，只给需要的槽位分配应用；空槽位会继续显示桌面。"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Button Content="导入" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ImportWorkspaces_Click"/>
                                <Button Content="备份" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ExportWorkspaces_Click" Margin="8,0,0,0"/>
                                <Button Content="智能捕捉" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CaptureWorkspace_Click" Margin="8,0,0,0"/>
                                <Button Content="手动捕捉" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ManualCaptureWorkspace_Click" Margin="8,0,0,0"/>
                                <Button Content="新建工作区" Style="{StaticResource AccentButtonStyle}"
                                        Click="NewWorkspace_Click" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ActiveWorkspaceBanner" Grid.Row="1" Style="{StaticResource CardStyle}"
                            Padding="15" Margin="0,0,0,16" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ActiveWorkspaceTitle" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveWorkspaceDetails" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="重新恢复" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Margin="12,0,0,0" Click="RestoreActiveWorkspace_Click"/>
                            <Button Grid.Column="2" Content="结束工作区" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Margin="8,0,0,0" Click="EndActiveWorkspace_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WorkspaceCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="280"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="264" Margin="0,0,16,16" Padding="15">
                                            <StackPanel>
                                                <controls:LayoutPreviewControl Layout="{Binding Workspace.Layout}"
                                                                               AssignedZoneIds="{Binding AssignedZoneIds}"
                                                                               Height="126"/>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="2,14,2,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11.5" Margin="2,5,2,13"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="恢复" Style="{StaticResource AccentButtonStyle}" Padding="14,7"
                                                            Tag="{Binding}" Click="RestoreCard_Click"/>
                                                    <Button Grid.Column="1" Content="检查" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                                            Margin="8,0,0,0" Tag="{Binding}" Click="CheckCard_Click"/>
                                                    <Button Grid.Column="2" Content="编辑" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                                            Margin="8,0,0,0" Tag="{Binding}" Click="EditCard_Click"/>
                                                    <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                                            Margin="8,0,0,0" Tag="{Binding}" Click="DeleteCard_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="38"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有工作区" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBlock Text="创建一个布局，然后把应用放进需要的槽位。"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="EditorView" Visibility="Collapsed">
                    <ScrollViewer x:Name="EditorScrollViewer" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="EditorScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="0,0,8,10">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="名称" FontWeight="SemiBold"/>
                                    <TextBox x:Name="WorkspaceNameBox" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="选择 Snap Layout" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="可视化编辑" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5"
                                                HorizontalAlignment="Right" Click="OpenVisualLayoutEditor_Click"/>
                                    </Grid>
                                    <TextBlock Text="布局定义屏幕区域；每个区域可以分配应用，也可以明确留空。"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,12"/>
                                    <ListBox x:Name="LayoutPicker" Background="Transparent" BorderThickness="0"
                                             SelectionChanged="LayoutPicker_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="148" Margin="3">
                                                    <controls:LayoutPreviewControl Layout="{Binding}" HighlightAllZones="True" Height="86"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="3,7,3,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="占用预览" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="紫色是应用，灰色是桌面" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,13"/>
                                        <controls:LayoutPreviewControl x:Name="EditorPreview" Height="190"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,11">
                                            <TextBlock Text="应用槽位" FontSize="16" FontWeight="SemiBold"/>
                                            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5"
                                                    HorizontalAlignment="Right" Click="RefreshWindows_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="ZoneRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,9">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="135"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ZoneTitle}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding ZoneDetails}" FontSize="10.5"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                                <controls:SmoothComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                                                                         SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                                         SelectionChanged="ZoneChoice_SelectionChanged">
                                                                    <controls:SmoothComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Details}" FontSize="10.5"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </controls:SmoothComboBox.ItemTemplate>
                                                                </controls:SmoothComboBox>
                                                                <Button Grid.Column="2" Content="已安装应用" Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Tag="{Binding}" Click="ChooseInstalledApplicationForZone_Click"/>
                                                            </Grid>
                                                            <Expander Header="启动选项" Margin="135,8,0,0">
                                                                <StackPanel Margin="0,7,0,0">
                                                                    <TextBlock Text="启动参数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="工作目录" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                                                                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                        <CheckBox Content="以管理员身份运行" IsChecked="{Binding RunAsAdministrator}"/>
                                                                        <CheckBox Content="始终启动新实例" IsChecked="{Binding AlwaysStartNewInstance}" Margin="18,0,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                             </Expander>
                                                            <Expander Header="窗口匹配规则" Margin="135,7,0,0">
                                                                <StackPanel Margin="0,7,0,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="进程识别" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            <ComboBox ItemsSource="{Binding ProcessMatchOptions}"
                                                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Mode"
                                                                                      SelectedValue="{Binding ProcessMode, Mode=TwoWay}" Margin="0,3,4,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="标题识别" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            <ComboBox ItemsSource="{Binding TitleMatchOptions}"
                                                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Mode"
                                                                                      SelectedValue="{Binding TitleMode, Mode=TwoWay}" Margin="4,3,0,0"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Text="标题匹配文字 / 表达式（留空时使用捕捉到的标题）"
                                                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                                                                    <TextBox Text="{Binding TitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                                    <CheckBox Content="必须是相同窗口类" IsChecked="{Binding RequireSameWindowClass}" Margin="0,7,0,0"/>
                                                                </StackPanel>
                                                            </Expander>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="兼容定位窗口" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="保持可见但不提交 SnapWindows；恢复时只按保存位置定位一次，适合不支持 Snap 的桌面程序。"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,5,0,10"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="CompatibilityRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PositionDetails}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="移除" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                                                    Tag="{Binding}" Click="RemoveCompatibilityApplication_Click"/>
                                                        </Grid>
                                                        <Expander Header="启动选项" Margin="0,7,0,0">
                                                            <StackPanel Margin="0,7,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="启动参数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,4,0"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="工作目录" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                        <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="4,3,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                    <CheckBox Content="以管理员身份运行" IsChecked="{Binding RunAsAdministrator}"/>
                                                                    <CheckBox Content="始终启动新实例" IsChecked="{Binding AlwaysStartNewInstance}" Margin="18,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="后台启动应用" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="不占用桌面槽位，也不会提交给 SnapWindows；恢复启动阶段会强制隐藏该应用出现的窗口。"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Button Content="从已安装应用添加" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5"
                                                    Click="ChooseInstalledBackgroundApplication_Click"/>
                                            <Button Content="手动添加" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" Margin="8,0,0,0"
                                                    Click="AddBackgroundApplication_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="BackgroundRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="名称" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                                <TextBlock Text="可执行文件" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" VerticalAlignment="Bottom"
                                                                    Tag="{Binding}" Click="BrowseBackgroundExecutable_Click"/>
                                                        </Grid>
                                                        <Grid Margin="0,7,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="启动参数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <TextBlock Text="工作目录" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Margin="0,7,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox Content="以管理员身份运行" IsChecked="{Binding RunAsAdministrator}"/>
                                                                <CheckBox Content="始终启动新实例" IsChecked="{Binding AlwaysStartNewInstance}" Margin="18,0,0,0"/>
                                                            </StackPanel>
                                                            <Button Content="移除" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                                                    Tag="{Binding}" Click="RemoveBackgroundApplication_Click"/>
                                                        </Grid>
                                                        <Expander Header="UWP / 打包应用 AUMID" Margin="0,6,0,0">
                                                            <TextBox Text="{Binding AppUserModelId, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="Library_Click"/>
                                <Button Content="仅保存" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                        Click="SaveWorkspace_Click"/>
                                <Button Content="保存并恢复" Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"
                                        Click="SaveAndRestore_Click"/>
                            </StackPanel>
                        </StackPanel>
