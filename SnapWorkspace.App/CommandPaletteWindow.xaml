<Window x:Class="SnapWorkspace.App.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snap Workspace 命令面板"
        Width="700" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Snap Workspace 命令面板"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="20" Padding="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.34" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/SnapWorkspace.png" Width="28" Height="28" Margin="0,0,11,0"/>
                        <StackPanel>
                            <TextBlock Text="Snap Workspace" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="搜索命令或工作区" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SecondarySurfaceBrush}"
                            CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="Esc" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Padding="42,13,14,13" FontSize="16"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             AutomationProperties.Name="搜索命令或工作区"/>
                </Grid>

                <ListBox x:Name="ResultsList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         AutomationProperties.Name="命令结果">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                    CornerRadius="10" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="17"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5"
                                                    Padding="6,2" Margin="8,0,0,0"
                                                    Visibility="{Binding PinnedVisibility}">
                                                <TextBlock Text="固定" FontSize="9" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Gesture}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"
                                               Margin="12,0,2,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="4,12,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                    <TextBlock Grid.Column="1" Text="↑↓ 选择　Enter 执行" FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
